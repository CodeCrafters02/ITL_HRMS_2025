API_BASE_URL=http://<your-pc-lan-ip>:8000

# Microsoft Entra ID (Azure AD) SSO
MS_CLIENT_ID=<application-client-id>
MS_TENANT_ID=<directory-tenant-id>
MS_REDIRECT_URI=com.innovyx.peoplesuite://oauthredirect

# Google OAuth (calendar / legacy Google sign-in)
GOOGLE_SERVER_CLIENT_ID=<web-client-id>.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=<ios-client-id>.apps.googleusercontent.com

# Login footer "Contact IT Support"
IT_SUPPORT_EMAIL=it-support@company.local
